<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/imap_account_instructions"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/imap_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/imap_host_hint"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/imap_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/imap_port_hint"
            android:inputType="number"
            android:singleLine="true"
            android:text="993" />

        <Spinner
            android:id="@+id/imap_security"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/imap_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/imap_username_hint"
            android:inputType="textEmailAddress"
            android:singleLine="true" />

        <EditText
            android:id="@+id/imap_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/imap_password_hint"
            android:inputType="textPassword"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/imap_auth_note"
            android:textColor="@android:color/darker_gray"
            android:textSize="13sp" />

        <Button
            android:id="@+id/imap_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/imap_save" />

        <Button
            android:id="@+id/imap_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/imap_cancel" />
    </LinearLayout>
</ScrollView>
